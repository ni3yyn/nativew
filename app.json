{
  "expo": {
    "name": "وثيق",
    "slug": "nativew",
    "scheme": "whathiq",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.wathiq",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.wathiq.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F5F0"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "runtimeVersion": "2.0.1"
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "barStyle": "dark-content"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "افتح المعرض اودي",
          "cameraPermission": "افتح الكاميرا اودي"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6010052879824695~4712614350",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
  "react-native-android-widget",
  {
    "fonts": [
      "./assets/fonts/Tajawal-Bold.ttf",
      "./assets/fonts/Tajawal-ExtraBold.ttf"
    ],
    "widgets": [
      {
        "name": "SpfTimerWidget",
        "label": "مؤقت وثيق (عريض 4x2)",
        "minWidth": "250dp",
        "minHeight": "110dp",
        "targetCellWidth": 4,
        "targetCellHeight": 2,
        "description": "مؤقت حماية من أشعة الشمس (لوحة عريضة)",
        "updatePeriodMillis": 1800000,
        "resizeMode": "horizontal|vertical"
      },
      {
        "name": "SpfTimerCompactWidget",
        "label": "مؤقت وثيق (مربع 2x2)",
        "minWidth": "110dp",
        "minHeight": "110dp",
        "targetCellWidth": 2,
        "targetCellHeight": 2,
        "description": "مؤقت حماية من أشعة الشمس (مربع صغير)",
        "updatePeriodMillis": 1800000,
        "resizeMode": "horizontal|vertical"
      }
    ]
  }
],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ebdbfe1-08ea-4f21-9fa2-482f152a3266"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6ebdbfe1-08ea-4f21-9fa2-482f152a3266",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
