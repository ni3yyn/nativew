<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Solid / Gradient Background (Tinted dynamically in Kotlin) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_base_shape"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- 🌟 TOP ROW: UV on the Left, City & Logo on the Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <!-- UV & Sun/Moon Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_uv_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_sun"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_uv_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:text="UV 8.5" />
            </LinearLayout>

            <!-- Middle Expanding Spacer -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- City Name + App Logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_city_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="وثيق" />

                <ImageView
                    android:id="@+id/widget_app_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🌟 CENTER HERO: Massive Typographic Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Live Ticking Chronometer -->
            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <!-- Static Text (For Idle/Expired/Safe states) -->
            <TextView
                android:id="@+id/widget_static_hero_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:text="00:00" />

            <!-- Subtitle Status -->
            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#A7F3D0"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:text="بانتظار البدء" />
        </LinearLayout>

        <!-- 🌟 PROGRESS BAR (Shown only when running) -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="75"
            android:progressDrawable="@drawable/widget_progress_horizontal"
            android:visibility="gone" />

        <!-- 🌟 DYNAMICALLY TINTABLE ACTION BUTTON -->
        <RelativeLayout
            android:id="@+id/widget_action_btn"
            android:layout_width="match_parent"
            android:layout_height="34dp">

            <!-- Button Background (Tinted dynamically in Kotlin) -->
            <ImageView
                android:id="@+id/widget_btn_bg_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/btn_bg"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:text="بدء المؤقت" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>