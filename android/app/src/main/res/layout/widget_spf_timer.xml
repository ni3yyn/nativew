<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Solid Background (Tinted dynamically in Kotlin) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_base_shape"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 🌟 TOP ROW: App Icon + City + UV Badge on Right, Refresh on Left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

            <!-- App Logo + App Name / City -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Small Brand Icon -->
                <ImageView
                    android:id="@+id/widget_app_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:layout_marginEnd="6dp" />

                <!-- City or App Name -->
                <TextView
                    android:id="@+id/widget_city_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="وثيق" />
            </LinearLayout>

            <!-- Spacer (Legal in RemoteViews) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- UV & Weather State -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_uv_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_widget_sun"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_uv_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:text="UV 8.5" />
            </LinearLayout>

            <!-- Refresh Button -->
            <ImageView
                android:id="@+id/widget_action_btn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:padding="3dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <!-- 🌟 CENTER HERO: Massive Typographic Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Live Ticking Chronometer -->
            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <!-- Static Text (For Expired/Safe states) -->
            <TextView
                android:id="@+id/widget_static_hero_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:text="00:00" />

            <!-- Subtitle Status -->
            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="#A7F3D0"
                android:textSize="13.5sp"
                android:layout_marginTop="2dp"
                android:text="حماية نشطة" />
        </LinearLayout>

        <!-- 🌟 BOTTOM ROW: Thick Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="75"
            android:progressDrawable="@drawable/widget_progress_horizontal" />
    </LinearLayout>
</RelativeLayout>